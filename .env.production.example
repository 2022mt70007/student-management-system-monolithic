# Copy to .env on the VM: cp .env.production.example .env && nano .env
# Never commit .env

# --- Database (change passwords from defaults) ---
DB_NAME=sms_monolith_db
DB_USER=sms_user
DB_PASSWORD=CHANGE_ME_strong_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# --- Secrets (generate new random values) ---
JWT_SECRET=CHANGE_ME_long_random_jwt_secret_at_least_64_chars
APP_ENCRYPTION_KEY=CHANGE_ME_32_char_encryption_key

# --- AWS SES ---
SES_MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
SES_MAIL_PORT=587
SES_SMTP_USERNAME=your-ses-smtp-username
SES_SMTP_PASSWORD=your-ses-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=sidharthsangamam@gmail.com
BOOTSTRAP_ADMIN_EMAIL=sidharthsangamam@gmail.com

# --- Domain (veritascampus.page on shared VM with veritascampus.me) ---
REGISTRATION_BASE_URL=https://veritascampus.page/register
APP_SECURITY_ALLOWED_ORIGINS=https://veritascampus.page,https://www.veritascampus.page
