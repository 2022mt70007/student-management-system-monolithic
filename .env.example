# Copy to .env and fill in your values (never commit .env)

# --- Local dev (MailHog — default when using docker compose) ---
# MailHog UI: http://localhost:8025
# No .env needed for local; docker-compose defaults to mailhog:1025.
# Optional explicit local overrides:
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=admin@sms.local
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# --- AWS SES (production / cloud VM) ---
# Uncomment and set these; comment out MailHog lines above.
# SES_MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# SES_MAIL_PORT=587
# SES_SMTP_USERNAME=your-ses-smtp-username
# SES_SMTP_PASSWORD=your-ses-smtp-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=your-verified-email@example.com
# BOOTSTRAP_ADMIN_EMAIL=your-verified-email@example.com

# Frontend URLs — must match the port where Vite runs (local or VM)
REGISTRATION_BASE_URL=http://localhost:5173/register
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloud deploy — set to your VM external IP (example):
# REGISTRATION_BASE_URL=http://YOUR_VM_IP:5176/register
# APP_SECURITY_ALLOWED_ORIGINS=http://YOUR_VM_IP:5176,http://127.0.0.1:5176

# Strong secrets for cloud (generate new values)
JWT_SECRET=StudentManagementSystemSecretKeyForJWT2024MustBeLongEnough
APP_ENCRYPTION_KEY=LocalDevEncryptionKeyChangeInProd
